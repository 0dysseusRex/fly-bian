[Unit]
Description=Fly /swapfile after first-boot resize (size from /etc/default/fly-swapfile)
Documentation=file:///usr/share/fly-debian/first-boot/README.txt
After=local-fs.target armbian-resize-filesystem.service
Before=fly-online-isolated-cpus.service fly-apply-fly-net.service
RequiresMountsFor=/
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fly-swapfile.sh

[Install]
WantedBy=multi-user.target
