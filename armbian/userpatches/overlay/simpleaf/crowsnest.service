[Unit]
Description=crowsnest - Multi Webcam/Streamer Control Daemon
Documentation=https://github.com/mainsail-crew/crowsnest
After=udev.service network-online.target nss-lookup.target
Wants=udev.service network-online.target
StartLimitBurst=3
StartLimitIntervalSec=180

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=__USER__
RemainAfterExit=yes
WorkingDirectory=__HOME__/crowsnest
# Real unit is written by `make install` under crowsnest; this is a
# fallback that matches the Python entrypoint. Prefer running
# install-crowsnest.sh (not marking crowsnest done in pellcorp.done)
# so ustreamer / camera-streamer packages are installed too.
Environment=CROWSNEST_ARGS=-c __HOME__/printer_data/config/crowsnest.conf
ExecStart=/usr/bin/python3 -m crowsnest $CROWSNEST_ARGS
Restart=on-failure
RestartSec=30
