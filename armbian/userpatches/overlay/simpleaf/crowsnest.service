[Unit]
Description=crowsnest - Multi Webcam/Streamer Control Daemon
Documentation=https://github.com/mainsail-crew/crowsnest
After=udev.service network-online.target nss-lookup.target
Wants=udev.service network-online.target
StartLimitBurst=3
StartLimitIntervalSec=180

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/crowsnest
# Fallback until `make install` / install-crowsnest.sh writes the real unit
# (venv + EnvironmentFile). Do not use Environment=CROWSNEST_ARGS=-c /path
# — systemd splits on '=' and drops the path.
ExecStart=/usr/bin/python3 -m crowsnest -c __HOME__/printer_data/config/crowsnest.conf -l __HOME__/printer_data/logs/crowsnest.log
Restart=on-failure
RestartSec=30
