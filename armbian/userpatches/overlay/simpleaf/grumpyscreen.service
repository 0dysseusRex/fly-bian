[Unit]
Description=GrumpyScreen
After=moonraker.service multi-user.target fly-boot-complete.service
# Own HDMI VT1; prefer GrumpyScreen over getty / KlipperScreen on this board.
Conflicts=getty@tty1.service
StartLimitIntervalSec=0
ConditionPathExists=/dev/tty1

[Service]
Type=simple
Restart=on-failure
RestartSec=5
User=__USER__
# Do not mirror stdout/stderr onto tty1 — that fights the framebuffer UI.
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
# + = run as root so we can write /run and touch tty1 before dropping to User=
ExecStartPre=+/bin/sh -c 'systemctl stop getty@tty1.service 2>/dev/null || true; systemctl mask getty@tty1.service 2>/dev/null || true'
ExecStartPre=+/bin/sh -c 'echo -ne "\\033[2J\\033[H\\033[?25l" > /dev/tty1'
ExecStartPre=+/usr/local/sbin/fly-grumpy-evdev.sh
WorkingDirectory=__HOME__/grumpyscreen
EnvironmentFile=-/run/fly-grumpy-evdev.env
Environment="CONFIG_FILE=__HOME__/grumpyscreen/grumpyscreen.cfg"
Environment="CONFIG_OVERRIDE_FILE=__HOME__/printer_data/config/grumpyscreen.ini"
Environment="WPA_SUPPLICANT_SOCKET=/var/run/wpa_supplicant"
ExecStart=__HOME__/grumpyscreen/grumpyscreen

[Install]
WantedBy=multi-user.target
