#!/bin/bash
# preinst helper: only install this board package on the matching device.
set -euo pipefail
want=$1
device=""
[[ -r /etc/fly-debian/flybian-device ]] && \
	device=$(tr -d '[:space:]' </etc/fly-debian/flybian-device)
if [[ $device != "$want" ]]; then
	echo "Package is for $want (this card is '${device:-unknown}')." >&2
	exit 1
fi
exit 0
