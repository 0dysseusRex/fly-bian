#!/bin/bash
# Fail if this card was baked below the package set's minimum image.
# Used by flybian-update and package preinst scripts.
set -euo pipefail

TABLE="${FLYBIAN_MIN_IMAGE_FILE:-/usr/share/fly-debian/min-image}"

_lib=/usr/lib/fly-debian
if [[ -f $_lib/infer-identity ]]; then
	# shellcheck disable=SC1091
	. "$_lib/infer-identity"
elif [[ -f "$(dirname "$0")/infer-identity" ]]; then
	# shellcheck disable=SC1091
	. "$(dirname "$0")/infer-identity"
fi

rank() {
	local v maj min
	v=$(printf '%s' "$1" | tr -d '[:space:]')
	maj=${v%%.*}
	if [[ $v == *.* ]]; then
		min=${v#*.}
		min=${min%%.*}
	else
		min=0
	fi
	maj=$((10#$maj))
	min=$((10#$min))
	printf '%s\n' $((maj * 100 + min))
}

if [[ ! -r $TABLE ]]; then
	echo "flybian: min-image table missing ($TABLE)" >&2
	exit 0
fi

if ! flybian_infer_device; then
	echo "flybian: cannot tell which board this is (no flybian-device / flybian-image)." >&2
	flybian_missing_device_msg
	exit 1
fi
device=$flybian_device

if ! flybian_infer_baked; then
	echo "flybian: no baked image version on this card." >&2
	exit 1
fi
baked=$flybian_baked

min=""
while read -r dev ver _; do
	[[ -z ${dev:-} || $dev == \#* ]] && continue
	if [[ $dev == "$device" ]]; then
		min=$ver
		break
	fi
done <"$TABLE"

if [[ -z $min ]]; then
	echo "flybian: no min-image line for device '$device'." >&2
	echo "Reflash a current Fly-bian image for this board." >&2
	exit 1
fi

if (($(rank "$baked") < $(rank "$min"))); then
	cat >&2 <<EOF
flybian: this card was baked as Fly-bian $baked ($device).
These packages need a card baked at Fly-bian $min or newer.

Your printer.cfg, gcode, and home directory cannot be upgraded in place
for this change (bootloader, partitions, or kernel ABI).

What to do:
  1. Copy off ~/printer_data (and any configs you care about).
  2. Flash the current Fly-bian image for $device.
  3. Copy printer_data back after first boot.

See: docs/howto-update.md
EOF
	exit 1
fi

exit 0
