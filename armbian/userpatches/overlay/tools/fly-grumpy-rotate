#!/bin/bash
# Set GrumpyScreen display rotation over SSH (0/1/2/3 = 0°/90°/180°/270°).
# Works with HDMI Fly-LCD and Fly TFT V2 (panel-mipi-dbi /dev/fb0).
# Writes ~/printer_data/config/grumpyscreen.ini (override) and restarts the unit.
set -euo pipefail

INI="${GRUMPY_INI:-$HOME/printer_data/config/grumpyscreen.ini}"
CFG="${GRUMPY_CFG:-$HOME/grumpyscreen/grumpyscreen.cfg}"
DRY_RUN=0
RESTART=1

usage() {
	cat <<'EOF'
Usage: fly-grumpy-rotate [options] [0|1|2|3]

Set GrumpyScreen UI rotation in 90° steps.
  0 = none, 1 = 90°, 2 = 180°, 3 = 270°

GrumpyScreen always paints /dev/fb0. On Fly Lite that is the SPI TFT
(panel-mipi-dbi) when fly-lite-tft is loaded; otherwise HDMI may own the
console. Touch is selected by fly-grumpy-evdev.sh (Fly-LCD, Goodix, or
ADS7846). Changing rotation discards touch calibration — follow the
on-screen crosshairs after restart.

With no rotation argument, prints the current value and display target.

Options:
  -c, --ini PATH    Override file (default: ~/printer_data/config/grumpyscreen.ini)
  -n, --dry-run     Show what would be written; do not write or restart
  --no-restart      Write config but do not restart grumpyscreen.service
  -h, --help        Show this help

Examples:
  fly-grumpy-rotate           # show current
  fly-grumpy-rotate 0         # landscape / no extra UI rotation
  fly-grumpy-rotate 3         # 270° (common for FPC panels)
EOF
}

current_rotate() {
	local f val=""
	for f in "$INI" "$CFG"; do
		[[ -f $f ]] || continue
		val=$(awk -F: '
			BEGIN{IGNORECASE=1; in_ui=0}
			/^\[/ { in_ui = (tolower($0) ~ /^\[ui\]/) }
			in_ui && /^[[:space:]]*display_rotate[[:space:]]*:/ {
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
				sub(/#.*/, "", $2)
				gsub(/[[:space:]]+/, "", $2)
				print $2
				exit
			}
		' "$f")
		[[ -n $val ]] && { printf '%s' "$val"; return 0; }
	done
	printf '%s' "?"
}

show_display_target() {
	local name="" size="" touch=""
	if [[ -r /sys/class/graphics/fb0/name ]]; then
		name=$(tr -d '\0' </sys/class/graphics/fb0/name)
	fi
	if [[ -r /sys/class/graphics/fb0/virtual_size ]]; then
		size=$(tr -d '\0' </sys/class/graphics/fb0/virtual_size)
	fi
	if [[ -e /dev/fb0 ]]; then
		echo "Framebuffer:  /dev/fb0${name:+ ($name)}${size:+ ${size}}"
		case "$name" in
			*panel-mipi*|*mipi-dbi*)
				echo "Display:      Fly TFT V2 (SPI panel-mipi-dbi)"
				echo "Note:         DT panel rotation is separate (fly-lite-tft.dts);"
				echo "              display_rotate here is GrumpyScreen UI orientation."
				;;
			*)
				echo "Display:      ${name:-unknown fb0} (HDMI / other)"
				;;
		esac
	else
		echo "Framebuffer:  /dev/fb0 missing — GrumpyScreen cannot start yet"
	fi
	if [[ -r /run/fly-grumpy-evdev.env ]]; then
		# shellcheck disable=SC1091
		touch=$(awk -F= '/^LVGL_EVDEV_DEV=/{print $2; exit}' /run/fly-grumpy-evdev.env)
	fi
	if [[ -n ${touch:-} ]]; then
		echo "Touch (env):  $touch"
	else
		# Preview what evdev helper would pick without requiring root write.
		if grep -q 'Goodix Capacitive TouchScreen' /proc/bus/input/devices 2>/dev/null; then
			echo "Touch:        Goodix GT911 (Cap) — set on grumpyscreen start"
		elif grep -q 'ADS7846' /proc/bus/input/devices 2>/dev/null; then
			echo "Touch:        ADS7846 (Resi) — set on grumpyscreen start"
		elif compgen -G '/dev/input/by-id/*Fly-LCD*event*' >/dev/null 2>&1; then
			echo "Touch:        Fly-LCD — set on grumpyscreen start"
		else
			echo "Touch:        none detected yet"
		fi
	fi
}

ROTATE=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		-c|--ini) INI=$2; shift 2 ;;
		-n|--dry-run) DRY_RUN=1; shift ;;
		--no-restart) RESTART=0; shift ;;
		-h|--help) usage; exit 0 ;;
		[0-3]) ROTATE=$1; shift ;;
		*) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
	esac
done

cur=$(current_rotate)
if [[ -z $ROTATE ]]; then
	echo "Current display_rotate: $cur"
	echo "Override file: $INI"
	echo "Base config:   $CFG"
	show_display_target
	exit 0
fi

echo "Current display_rotate: $cur"
echo "Setting display_rotate: $ROTATE"
echo "Writing: $INI"
show_display_target

if [[ $DRY_RUN -eq 1 ]]; then
	echo "Dry-run only; not writing or restarting."
	exit 0
fi

mkdir -p "$(dirname "$INI")"
python3 - "$INI" "$ROTATE" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
rotate = sys.argv[2]
text = path.read_text(encoding="utf-8") if path.is_file() else ""

if re.search(r"(?im)^\[ui\]", text):
    if re.search(r"(?im)^[ \t]*display_rotate[ \t]*:", text):
        # replace only inside [ui] section
        parts = re.split(r"(?=^\[)", text, flags=re.M)
        out = []
        for part in parts:
            if re.match(r"(?im)^\[ui\]", part.lstrip()):
                if re.search(r"(?im)^[ \t]*display_rotate[ \t]*:", part):
                    part = re.sub(
                        r"(?im)^([ \t]*display_rotate[ \t]*:)[^\n]*$",
                        rf"\g<1> {rotate}",
                        part,
                        count=1,
                    )
                else:
                    lines = part.splitlines(True)
                    # insert after [ui] header
                    lines.insert(1, f"display_rotate: {rotate}\n")
                    part = "".join(lines)
            out.append(part)
        text = "".join(out)
    else:
        text = re.sub(
            r"(?im)^(\[ui\][^\n]*\n)",
            rf"\1display_rotate: {rotate}\n",
            text,
            count=1,
        )
else:
    if text and not text.endswith("\n"):
        text += "\n"
    text += f"\n[ui]\ndisplay_rotate: {rotate}\n"

path.write_text(text, encoding="utf-8")
print(f"wrote {path}")
PY

# Keep base cfg in sync — Simple-AF install can replace the override ini
# with pellcorp's template (which may omit display_rotate).
if [[ -f $CFG ]]; then
	if grep -qiE '^[[:space:]]*display_rotate[[:space:]]*:' "$CFG"; then
		sed -i -E "s/^[[:space:]]*display_rotate[[:space:]]*:.*/display_rotate: ${ROTATE}/" "$CFG"
	else
		printf '\n[ui]\ndisplay_rotate: %s\n' "$ROTATE" >>"$CFG"
	fi
	echo "Also updated base config: $CFG"
fi

if [[ $RESTART -eq 1 ]]; then
	if systemctl cat grumpyscreen.service >/dev/null 2>&1; then
		echo "Restarting grumpyscreen..."
		if sudo -n systemctl restart grumpyscreen 2>/dev/null; then
			:
		else
			sudo systemctl restart grumpyscreen
		fi
		echo "Done. Touch will recalibrate if rotation changed ($cur -> $ROTATE)."
	else
		echo "grumpyscreen.service not found; config updated only."
		echo "On next GrumpyScreen start it will use display_rotate=$ROTATE on /dev/fb0."
	fi
fi
