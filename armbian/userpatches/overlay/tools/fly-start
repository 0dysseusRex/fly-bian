#!/bin/bash
# fly-start — interactive Simple-AF install/update using FLY-SETUP fly-start.txt
set -euo pipefail

LOGTAG=fly-start

log() { printf '%s\n' "$*"; }

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

if [[ ${EUID:-0} -eq 0 ]]; then
	die "Run as your sudo user (e.g. fly), not root."
fi

find_start_file() {
	local cand mp
	for cand in \
		"$HOME/fly-start.txt" \
		/boot/fly-start.txt \
		/usr/share/fly-debian/first-boot/fly-start.txt \
		/boot/fly-net.txt \
		/usr/share/fly-debian/first-boot/fly-net.txt
	do
		[[ -f $cand ]] && { printf '%s' "$cand"; return 0; }
	done
	for mp in /mnt/FLY-SETUP /media/FLY-SETUP; do
		for cand in "$mp/fly-start.txt" "$mp/fly-net.txt"; do
			[[ -f $cand ]] && { printf '%s' "$cand"; return 0; }
		done
	done
	return 1
}

yesish() {
	case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
		y|yes|true|1) return 0 ;;
		*) return 1 ;;
	esac
}

get_key() {
	local file=$1 key=$2
	local line val
	line=$(grep -E "^${key}=" "$file" | tail -n 1 || true)
	[[ -z $line ]] && { printf ''; return 0; }
	val=${line#*=}
	val=${val%\"}
	val=${val#\"}
	val=${val%\'}
	val=${val#\'}
	# trim spaces
	val=$(printf '%s' "$val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
	printf '%s' "$val"
}

expand_home() {
	# Expand leading ~/ only
	local s=$1
	case "$s" in
		~/*) printf '%s%s' "$HOME" "${s:1}" ;;
		*) printf '%s' "$s" ;;
	esac
}

enable_grumpyscreen() {
	if [[ -x $HOME/grumpyscreen/grumpyscreen ]] || [[ -f /etc/systemd/system/grumpyscreen.service ]]; then
		sudo systemctl stop getty@tty1.service 2>/dev/null || true
		sudo systemctl disable getty@tty1.service 2>/dev/null || true
		sudo systemctl mask getty@tty1.service 2>/dev/null || true
		sudo systemctl enable grumpyscreen.service 2>/dev/null || true
		sudo systemctl restart grumpyscreen.service 2>/dev/null || \
			sudo systemctl start grumpyscreen.service 2>/dev/null || \
			log "WARN: could not start grumpyscreen (check HDMI /dev/tty1)."
		log "GrumpyScreen enabled (touch UI on HDMI VT1)."
	else
		log "WARN: GrumpyScreen binary/unit not found; re-run after stack bind/install."
	fi
}

disable_grumpyscreen() {
	sudo systemctl disable --now grumpyscreen.service 2>/dev/null || true
	sudo systemctl unmask getty@tty1.service 2>/dev/null || true
	sudo systemctl enable getty@tty1.service 2>/dev/null || true
	log "GrumpyScreen left disabled (ENABLE_GRUMPYSCREEN is not Yes)."
}

run_boot_display() {
	local action=$1
	if command -v fly-boot-display >/dev/null 2>&1; then
		fly-boot-display "$action"
	elif [[ -x /usr/local/bin/fly-boot-display ]]; then
		/usr/local/bin/fly-boot-display "$action"
	else
		log "WARN: fly-boot-display not installed."
		return 1
	fi
}

run_grumpy_rotate() {
	# Optional arg: 0|1|2|3 — omit to show current.
	if command -v fly-grumpy-rotate >/dev/null 2>&1; then
		fly-grumpy-rotate "$@"
	elif [[ -x /usr/local/bin/fly-grumpy-rotate ]]; then
		/usr/local/bin/fly-grumpy-rotate "$@"
	else
		log "WARN: fly-grumpy-rotate not installed."
		return 1
	fi
}

SRC=$(find_start_file) || die "fly-start.txt not found (expected on FLY-SETUP / /boot)."
WORK=$(mktemp)
tr -d '\r' <"$SRC" >"$WORK"
trap 'rm -f "$WORK"' EXIT

INSTALL_CMD=$(get_key "$WORK" INSTALL_CMD)
AUTO_CAMERAS=$(get_key "$WORK" AUTO_CAMERAS)
ENABLE_GRUMPY=$(get_key "$WORK" ENABLE_GRUMPYSCREEN)
BOOT_DISPLAY=$(get_key "$WORK" INSTALL_BOOT_DISPLAY)
# Legacy: older fly-start.txt used INSTALL_BOOT_DISPLAY for GrumpyScreen.
# If ENABLE_GRUMPYSCREEN is absent, do not treat INSTALL_BOOT_DISPLAY as Grumpy.

[[ -n $INSTALL_CMD ]] || INSTALL_CMD='~/pellcorp/installer.sh --install --printer YourPrinter --probe YourProbe'

cat <<EOF
Fly-bian — fly-start
====================
Config: $SRC

From fly-start.txt:
  INSTALL_CMD=$INSTALL_CMD
  AUTO_CAMERAS=$AUTO_CAMERAS
  ENABLE_GRUMPYSCREEN=$ENABLE_GRUMPY
  INSTALL_BOOT_DISPLAY=$BOOT_DISPLAY

  ENABLE_GRUMPYSCREEN  = touch UI on Fly-LCD after boot (not a splash)
  INSTALL_BOOT_DISPLAY = Plymouth early-boot logo (Simple-AF theme)

Choose:
  1) Run Full Install Script
  2) Update Simple AF
  3) Enable boot display (Plymouth splash)
  4) Disable boot display (text boot sequence / diagnostics)
  5) Show GrumpyScreen rotation
  6) Set GrumpyScreen rotation (0° / 90° / 180° / 270°)
  7) Cancel
EOF

printf 'Enter choice [1-7]: '
read -r choice || true
case "$choice" in
	1)
		cmd=$(expand_home "$INSTALL_CMD")
		log ""
		log "=== Full install ==="
		log "Running: $cmd"
		log ""
		# shellcheck disable=SC2086
		bash -lc "$cmd" || die "installer failed (exit $?)"
		log ""
		log "Installer finished."

		# Moonraker PolKit (reboot/restart from Mainsail). Bind often fails
		# here because set-policykit-rules needs interactive sudo.
		if command -v fly-moonraker-polkit >/dev/null; then
			log ""
			log "=== Moonraker PolKit rules ==="
			fly-moonraker-polkit "$(id -un)" || log "WARN: fly-moonraker-polkit failed."
		fi

		# Shake&Tune: bake ships the tree; ensure [shaketune] is linked into klippy extras.
		if command -v fly-ensure-shaketune >/dev/null; then
			log ""
			log "=== Shake&Tune module link ==="
			fly-ensure-shaketune "$(id -un)" || log "WARN: fly-ensure-shaketune failed (section may be invalid until linked)."
		fi
		if [[ -f $HOME/klippain_shaketune/shaketune/shaketune.py ]]; then
			if [[ -x /usr/share/fly-debian/simpleaf/patch-shaketune-importlib.sh ]]; then
				bash /usr/share/fly-debian/simpleaf/patch-shaketune-importlib.sh \
					"$HOME/klippain_shaketune/shaketune/shaketune.py" || true
			fi
		fi

		if yesish "$AUTO_CAMERAS"; then
			log ""
			log "=== AUTO_CAMERAS=Yes — adding USB cameras ==="
			if command -v fly-crowsnest-add-cams >/dev/null; then
				# Ensures ustreamer + enable --now restart so streams show immediately.
				fly-crowsnest-add-cams || log "WARN: fly-crowsnest-add-cams reported an error (cam may be missing)."
			else
				log "WARN: fly-crowsnest-add-cams not installed."
			fi
			# Always kick crowsnest after install even if cams were already in conf.
			if systemctl cat crowsnest.service >/dev/null 2>&1; then
				sudo systemctl enable --now crowsnest 2>/dev/null || true
				sudo systemctl restart crowsnest 2>/dev/null || true
			fi
		else
			log "Skipping cameras (AUTO_CAMERAS is not Yes)."
		fi

		if yesish "$ENABLE_GRUMPY"; then
			log ""
			log "=== ENABLE_GRUMPYSCREEN=Yes ==="
			enable_grumpyscreen
		else
			log ""
			log "=== ENABLE_GRUMPYSCREEN is not Yes ==="
			disable_grumpyscreen
		fi

		if yesish "$BOOT_DISPLAY"; then
			log ""
			log "=== INSTALL_BOOT_DISPLAY=Yes — Plymouth Simple-AF splash ==="
			run_boot_display enable || true
		else
			log "Skipping Plymouth boot display (INSTALL_BOOT_DISPLAY is not Yes)."
		fi
		log ""
		log "Done. Fluidd: http://$(hostname -I 2>/dev/null | awk '{print $1}')/"
		;;
	2)
		log ""
		log "=== Update Simple AF ==="
		update_cmd=$(expand_home '~/pellcorp/installer.sh --update')
		log "Running: $update_cmd"
		bash -lc "$update_cmd" || die "update failed (exit $?)"
		log "Update finished."
		;;
	3)
		log ""
		log "=== Enable boot display ==="
		run_boot_display enable || die "fly-boot-display enable failed"
		;;
	4)
		log ""
		log "=== Disable boot display (diagnostic text boot) ==="
		run_boot_display disable || die "fly-boot-display disable failed"
		;;
	5)
		log ""
		log "=== GrumpyScreen rotation (current) ==="
		run_grumpy_rotate || die "fly-grumpy-rotate failed"
		;;
	6)
		log ""
		log "=== Set GrumpyScreen rotation ==="
		log "  0 = 0°    1 = 90°    2 = 180°    3 = 270° (common for FPC panels)"
		printf 'Enter rotation [0-3]: '
		read -r rot || true
		case "$rot" in
			0|1|2|3)
				run_grumpy_rotate "$rot" || die "fly-grumpy-rotate $rot failed"
				;;
			*)
				die "Invalid rotation: ${rot:-empty} (use 0, 1, 2, or 3)"
				;;
		esac
		;;
	7|""|q|Q)
		log "Cancelled."
		exit 0
		;;
	*)
		die "Invalid choice: $choice"
		;;
esac
