#!/bin/bash
# fly-kiauh — KIAUH image helper: start KIAUH or add USB cameras.
set -euo pipefail

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
log() { printf '%s\n' "$*"; }

if [[ ${EUID:-0} -eq 0 ]]; then
	die "Run as your sudo user (e.g. fly), not root."
fi

# KIAUH writes kiauh.cfg and runs git in its own tree. The bake copy lives
# under /opt as root; running that as the login user hits dubious-ownership
# and PermissionError. Always use a home-owned copy.
ensure_user_kiauh() {
	local src=/opt/fly-kiauh/kiauh dest=$HOME/kiauh
	if [[ -f $dest/kiauh.sh ]]; then
		return 0
	fi
	[[ -d $src ]] || return 0
	mkdir -p "$dest"
	if command -v rsync >/dev/null 2>&1; then
		rsync -rltD "$src/" "$dest/"
	else
		cp -a "$src/." "$dest/"
	fi
	chmod -R u+rwX "$dest" 2>/dev/null || true
}

run_kiauh() {
	ensure_user_kiauh
	if [[ -f $HOME/kiauh/kiauh.sh ]]; then
		exec bash "$HOME/kiauh/kiauh.sh" "$@"
	fi
	die "KIAUH not found (expected ~/kiauh/kiauh.sh). Wait for first-boot bind, then try again."
}

run_cameras() {
	log "=== USB cameras (Crowsnest) ==="
	if command -v fly-crowsnest-add-cams >/dev/null 2>&1; then
		fly-crowsnest-add-cams || log "WARN: fly-crowsnest-add-cams reported an error (cam may be missing)."
	elif [[ -x /usr/local/bin/fly-crowsnest-add-cams ]]; then
		/usr/local/bin/fly-crowsnest-add-cams || log "WARN: fly-crowsnest-add-cams reported an error (cam may be missing)."
	else
		die "fly-crowsnest-add-cams not installed"
	fi
	if systemctl cat crowsnest.service >/dev/null 2>&1; then
		sudo systemctl enable --now crowsnest 2>/dev/null || true
		sudo systemctl restart crowsnest 2>/dev/null || true
	fi
}

# Direct modes: fly-kiauh cameras | fly-kiauh -- … (pass-through to kiauh.sh)
case "${1:-}" in
	cameras|camera|cams|cam)
		run_cameras
		exit 0
		;;
	-h|--help|help)
		cat <<'EOF'
fly-kiauh — KIAUH image helper

  fly-kiauh              Interactive menu (Start KIAUH / Add USB cameras)
  fly-kiauh cameras      Add USB cameras into Crowsnest
  fly-kiauh [args…]      Pass remaining args to ~/kiauh/kiauh.sh
EOF
		exit 0
		;;
	"")
		;;
	*)
		run_kiauh "$@"
		;;
esac

if [[ -d $HOME/klipper || -d /opt/fly-kiauh/klipper ]]; then
	cat <<'EOF'
Fly-bian — fly-kiauh
===================
Klipper/Moonraker trees are pre-baked. Use KIAUH for printer.cfg and services.

Choose:
  1) Start KIAUH
  2) Add USB cameras
  3) Cancel
EOF
else
	cat <<'EOF'
Fly-bian — fly-kiauh
===================
KIAUH is on this image. Klipper, Moonraker, and the web UIs are not.
Use KIAUH to install them.

Choose:
  1) Start KIAUH
  2) Add USB cameras
  3) Cancel
EOF
fi
printf 'Enter choice [1-3]: '
read -r choice || true
case "$choice" in
	1)
		log ""
		log "=== Start KIAUH ==="
		run_kiauh
		;;
	2)
		log ""
		run_cameras
		log "Done."
		;;
	3|""|q|Q)
		log "Cancelled."
		exit 0
		;;
	*)
		die "Invalid choice: $choice"
		;;
esac
