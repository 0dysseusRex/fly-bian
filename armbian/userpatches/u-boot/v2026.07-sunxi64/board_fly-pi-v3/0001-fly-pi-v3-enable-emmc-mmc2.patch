From: Fly-bian <fly-bian@local>
Subject: [PATCH] fly-pi-v3: enable eMMC (mmc2) for SPL/U-Boot

Orange Pi Zero3 leaves SLOT_EXTRA=-1; Fly Pi V3 SPL boots MMC2 and
needs U-Boot mmc device 1 (eMMC). Enable slot 2 + &mmc2 okay.

--- a/configs/orangepi_zero3_defconfig
+++ b/configs/orangepi_zero3_defconfig
@@ -14,6 +14,8 @@
 CONFIG_MACH_SUN50I_H616=y
 CONFIG_SUNXI_DRAM_H616_LPDDR4=y
 CONFIG_R_I2C_ENABLE=y
+CONFIG_MMC_SUNXI_SLOT_EXTRA=2
+CONFIG_SUPPORT_EMMC_BOOT=y
 CONFIG_SPL_SPI_SUNXI=y
 # CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
 CONFIG_SPL_I2C=y
--- a/dts/upstream/src/arm64/allwinner/sun50i-h618-orangepi-zero3.dts
+++ b/dts/upstream/src/arm64/allwinner/sun50i-h618-orangepi-zero3.dts
@@ -40,6 +40,15 @@
 	vmmc-supply = <&reg_dldo1>;
 };
 
+&mmc2 {
+	vmmc-supply = <&reg_dldo1>;
+	vqmmc-supply = <&reg_aldo1>;
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	status = "okay";
+};
+
 &r_i2c {
 	status = "okay";
 
