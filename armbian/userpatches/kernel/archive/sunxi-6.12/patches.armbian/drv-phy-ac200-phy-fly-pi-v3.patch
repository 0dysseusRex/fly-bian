+static int ac200_ephy_get_features(struct phy_device *phydev)
+{
+	/* BMSR omits 100baseT and autoneg. FlyOS forces basic features. */
+	linkmode_copy(phydev->supported, phy_basic_features);
 	return 0;
 }
 
