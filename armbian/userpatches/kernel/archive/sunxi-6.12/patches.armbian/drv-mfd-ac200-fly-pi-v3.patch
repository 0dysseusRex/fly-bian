+static int ac200_twi_wait(void __iomem *twi, u32 *stat)
+{
+	int i;
+	u32 ctrl;
+
+	for (i = 0; i < 2000; i++) {
+		ctrl = readl(twi + 0x0c);
+		if (ctrl & (1u << 3)) {
+			udelay(1);
+			*stat = readl(twi + 0x10);
+			/* f8/f9 is idle status; the real code can land after the flag. */
+			if (*stat != 0xf8 && *stat != 0xf9)
+				return 0;
+		}
+		udelay(5);
+	}
+	*stat = readl(twi + 0x10);
+	return -ETIMEDOUT;
+}
+
+static int ac200_twi_mask(struct i2c_client *i2c)
+{
+	struct platform_device *pdev;
+	int irq;
+
+	pdev = to_platform_device(i2c->adapter->dev.parent);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	disable_irq(irq);
+	return irq;
+}
+
+static void ac200_twi_kick(void __iomem *twi, u32 bits)
+{
+	/* Latch the byte, then write the flag bit as 1 to clear it. */
+	writel(bits, twi + 0x0c);
+	writel(bits | (1u << 3), twi + 0x0c);
+}
+
+static void ac200_twi_stop(void __iomem *twi)
+{
+	writel((1u << 7) | (1u << 6) | (1u << 4), twi + 0x0c);
+	writel((1u << 7) | (1u << 6) | (1u << 3), twi + 0x0c);
+}
+
+static int ac200_twi_addr(struct i2c_client *i2c, void __iomem *twi,
+			  u32 readbit, u32 *stat)
+{
+	int ret;
+
+	u32 ctrl;
+
+	writel((1u << 7) | (1u << 6) | (1u << 5) | (1u << 2), twi + 0x0c);
+	ret = ac200_twi_wait(twi, stat);
+	ctrl = readl(twi + 0x0c);
+	if (ret) {
+		dev_warn(&i2c->dev, "AC200 twi start stat %02x ctrl %02x\n",
+			 *stat, ctrl);
+		return ret;
+	}
+	dev_info(&i2c->dev, "AC200 twi start stat %02x ctrl %02x\n",
+		 *stat, ctrl);
+	if (*stat == 0x18 || *stat == 0x20 || *stat == 0x40 || *stat == 0x48)
+		return 0;
+	if (*stat != 0x08 && *stat != 0x10)
+		return -EIO;
+	writel(((u32)(i2c->addr & 0x7f) << 1) | readbit, twi + 0x08);
+	ac200_twi_kick(twi, (1u << 7) | (1u << 6) | (1u << 2));
+	ret = ac200_twi_wait(twi, stat);
+	ctrl = readl(twi + 0x0c);
+	if (ret) {
+		dev_warn(&i2c->dev, "AC200 twi addr stat %02x ctrl %02x\n",
+			 *stat, ctrl);
+		return ret;
+	}
+	dev_info(&i2c->dev, "AC200 twi addr stat %02x ctrl %02x\n",
+		 *stat, ctrl);
+	return 0;
+}
+
+static int ac200_twi_write(void *context, const void *data, size_t count)
+{
+	struct i2c_client *i2c = context;
+	const u8 *buf = data;
+	void __iomem *twi;
+	u32 stat = 0;
+	size_t n;
+	int irq;
+	int ret = -EIO;
+
+	irq = ac200_twi_mask(i2c);
+	if (irq < 0)
+		return irq;
+	twi = ioremap(0x05002c00, 0x24);
+	if (!twi) {
+		enable_irq(irq);
+		return -ENOMEM;
+	}
+	ret = ac200_twi_addr(i2c, twi, 0, &stat);
+	if (ret)
+		goto out;
+	if (stat != 0x18) {
+		ret = -ENXIO;
+		goto out;
+	}
+	for (n = 0; n < count; n++) {
+		writel(buf[n], twi + 0x08);
+		ac200_twi_kick(twi, (1u << 7) | (1u << 2) | (1u << 6));
+		ret = ac200_twi_wait(twi, &stat);
+		if (ret || stat != 0x28) {
+			ret = ret ? ret : -EIO;
+			goto out;
+		}
+	}
+	ret = 0;
+out:
+	if (ret != -ETIMEDOUT)
+		ac200_twi_stop(twi);
+	else if (readl(twi + 0x0c) & (1u << 3))
+		writel((1u << 6) | (1u << 3), twi + 0x0c);
+	iounmap(twi);
+	enable_irq(irq);
+	return ret;
+}
+
+static int ac200_twi_read(void *context, const void *reg_buf, size_t reg_size,
+			  void *val_buf, size_t val_size)
+{
+	struct i2c_client *i2c = context;
+	const u8 *reg = reg_buf;
+	u8 *val = val_buf;
+	void __iomem *twi;
+	u32 stat = 0;
+	size_t n;
+	int irq;
+	int ret = -EIO;
+
+	irq = ac200_twi_mask(i2c);
+	if (irq < 0)
+		return irq;
+	twi = ioremap(0x05002c00, 0x24);
+	if (!twi) {
+		enable_irq(irq);
+		return -ENOMEM;
+	}
+	ret = ac200_twi_addr(i2c, twi, 0, &stat);
+	if (ret)
+		goto out;
+	if (stat != 0x18) {
+		ret = -ENXIO;
+		goto out;
+	}
+	for (n = 0; n < reg_size; n++) {
+		writel(reg[n], twi + 0x08);
+		ac200_twi_kick(twi, (1u << 7) | (1u << 2) | (1u << 6));
+		ret = ac200_twi_wait(twi, &stat);
+		if (ret || stat != 0x28) {
+			ret = ret ? ret : -EIO;
+			goto out;
+		}
+	}
+	ret = ac200_twi_addr(i2c, twi, 1, &stat);
+	if (ret)
+		goto out;
+	if (stat != 0x40) {
+		ret = -ENXIO;
+		goto out;
+	}
+	for (n = 0; n < val_size; n++) {
+		u32 bits = (1u << 7) | (1u << 6);
+
+		if (n + 1 < val_size)
+			bits |= (1u << 2);
+		ac200_twi_kick(twi, bits);
+		ret = ac200_twi_wait(twi, &stat);
+		if (ret)
+			goto out;
+		if (n + 1 < val_size) {
+			if (stat != 0x50) {
+				ret = -EIO;
+				goto out;
+			}
+		} else if (stat != 0x58) {
+			ret = -EIO;
+			goto out;
+		}
+		val[n] = readl(twi + 0x08) & 0xff;
+	}
+	ret = 0;
+out:
+	if (ret != -ETIMEDOUT)
+		ac200_twi_stop(twi);
+	else if (readl(twi + 0x0c) & (1u << 3))
+		writel((1u << 6) | (1u << 3), twi + 0x0c);
+	iounmap(twi);
+	enable_irq(irq);
+	return ret;
+}
+
+static const struct regmap_bus ac200_i2c_bus = {
+	.write = ac200_twi_write,
+	.read = ac200_twi_read,
+};
