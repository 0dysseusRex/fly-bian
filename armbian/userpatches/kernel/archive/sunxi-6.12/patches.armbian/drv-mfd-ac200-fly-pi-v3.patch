+
+static u32 ac200_mdio_read_reg(void __iomem *mac, u32 addr, u32 reg)
+{
+	u32 cmd;
+	int spins;
+
+	for (spins = 0; spins < 1000; spins++) {
+		if (!(readl(mac + 0x48) & 1u))
+			break;
+		udelay(10);
+	}
+	cmd = (3u << 20) | ((addr & 0x1fu) << 12) | ((reg & 0x1fu) << 4) | 1u;
+	writel(cmd, mac + 0x48);
+	for (spins = 0; spins < 1000; spins++) {
+		if (!(readl(mac + 0x48) & 1u))
+			break;
+		udelay(10);
+	}
+	return readl(mac + 0x4c);
+}
+
+static void ac200_mdio_write_reg(void __iomem *mac, u32 addr, u32 reg, u32 val)
+{
+	u32 cmd;
+	int spins;
+
+	for (spins = 0; spins < 1000; spins++) {
+		if (!(readl(mac + 0x48) & 1u))
+			break;
+		udelay(10);
+	}
+	cmd = (3u << 20) | ((addr & 0x1fu) << 12) | ((reg & 0x1fu) << 4) | 3u;
+	writel(val & 0xffffu, mac + 0x4c);
+	writel(cmd, mac + 0x48);
+	for (spins = 0; spins < 1000; spins++) {
+		if (!(readl(mac + 0x48) & 1u))
+			break;
+		udelay(10);
+	}
+}
+
+static void ac200_mdio_scan(struct i2c_client *i2c)
+{
+	struct device_node *emac;
+	struct platform_device *pdev = NULL;
+	struct pinctrl *pins = ERR_PTR(-ENODEV);
+	struct clk *bus;
+	struct reset_control *rst;
+	void __iomem *pwm, *mac = NULL, *ephy = NULL;
+	u32 per, pclk, ppr, was, hi, lo;
+	int addr, found = 0, held = 0;
+
+	pwm = ioremap(0x0300a000, 0x110);
+	if (!pwm) {
+		dev_warn(&i2c->dev, "AC200 pwm map failed\n");
+		return;
+	}
+	/* Read only. PCCR45 bit 6 stays set, so PWM5 remains the 24 MHz bypass. */
+	pclk = readl(pwm + 0x28);
+	per = readl(pwm + 0x40);
+	ppr = readl(pwm + 0x104);
+	dev_info(&i2c->dev, "AC200 pwm per %08x clk %08x ppr %08x\n",
+		 per, pclk, ppr);
+	iounmap(pwm);
+
+	emac = of_find_compatible_node(NULL, NULL, "allwinner,sunxi-gmac");
+	if (!emac) {
+		dev_warn(&i2c->dev, "AC200 emac node missing\n");
+		return;
+	}
+	bus = of_clk_get(emac, 0);
+	if (IS_ERR(bus)) {
+		dev_warn(&i2c->dev, "AC200 emac bus clk %ld\n", PTR_ERR(bus));
+		of_node_put(emac);
+		return;
+	}
+	clk_prepare_enable(bus);
+	rst = of_reset_control_get_exclusive(emac, "stmmaceth");
+	if (IS_ERR(rst))
+		dev_warn(&i2c->dev, "AC200 emac reset %ld\n", PTR_ERR(rst));
+	else
+		reset_control_deassert(rst);
+
+	ephy = ioremap(0x03000034, 0x4);
+	mac = ioremap(0x05030000, 0x100);
+	if (!ephy || !mac) {
+		dev_warn(&i2c->dev, "AC200 emac map failed\n");
+		goto out;
+	}
+	was = readl(ephy);
+	writel(0x00053fe1, ephy);
+	dev_info(&i2c->dev, "AC200 emac clk %08x was %08x\n",
+		 readl(ephy), was);
+	pdev = of_find_device_by_node(emac);
+	if (!pdev) {
+		dev_info(&i2c->dev, "AC200 pins node\n");
+		goto out;
+	}
+	pins = pinctrl_get_select_default(&pdev->dev);
+	if (IS_ERR(pins)) {
+		dev_info(&i2c->dev, "AC200 pins %ld\n", PTR_ERR(pins));
+		goto out;
+	}
+	dev_info(&i2c->dev, "AC200 pins ok\n");
+	msleep(50);
+	ac200_mdio_write_reg(mac, 0x10, 0, 0x1f83);
+	ac200_mdio_write_reg(mac, 0x10, 0, 0x1fb7);
+	ac200_mdio_write_reg(mac, 0x10, 5, 0xa819);
+	ac200_mdio_write_reg(mac, 0x10, 6, 0x0000);
+	msleep(1000);
+	hi = ac200_mdio_read_reg(mac, 0x10, 6);
+	hi &= ~(0xfu << 12);
+	hi |= ((0x03u + 0x0506u) & 0xfu) << 12;
+	hi |= (1u << 11) | (1u << 1);
+	ac200_mdio_write_reg(mac, 0x10, 6, hi);
+	dev_info(&i2c->dev, "AC200 mdio en 10 rmii %04x\n",
+		 ac200_mdio_read_reg(mac, 0x10, 6));
+	held = 1;
+	for (addr = 0; addr < 32; addr++) {
+		hi = ac200_mdio_read_reg(mac, addr, 2);
+		lo = ac200_mdio_read_reg(mac, addr, 3);
+		if (!hi && !lo)
+			continue;
+		found = 1;
+		dev_info(&i2c->dev, "AC200 mdio %02x id %08x %08x\n",
+			 addr, hi, lo);
+	}
+	if (!found)
+		dev_info(&i2c->dev, "AC200 mdio none\n");
+out:
+	if (!IS_ERR(pins))
+		pinctrl_put(pins);
+	if (pdev)
+		platform_device_put(pdev);
+	if (mac)
+		iounmap(mac);
+	if (ephy)
+		iounmap(ephy);
+	if (!IS_ERR(rst))
+		reset_control_put(rst);
+	if (!held) {
+		clk_disable_unprepare(bus);
+		clk_put(bus);
+	}
+	of_node_put(emac);
+}
