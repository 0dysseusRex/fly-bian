# Skip git ls-remote for U-Boot (fails in this Docker/WSL path).
# v2026.07^{} == ece349ade2973e220f524ce59e59711cc919263f (same as sunxi_common.inc tag:v2026.07)
BOOTBRANCH="commit:ece349ade2973e220f524ce59e59711cc919263f"

# WSL/Docker: bare `sync` often never finishes (dirty writeback / virtio-blk).
# Armbian's wait_for_disk_sync() loops forever; a timed sync still leaves
# unreapable D-state sync zombies that wedge container cleanup. Skip entirely.
function wait_for_disk_sync() {
	display_alert "WSL: skip wait_for_disk_sync" "$*" "info"
	return 0
}
